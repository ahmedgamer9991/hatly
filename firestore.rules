rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the target user document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to retrieve requesting user's profile document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 1. Users collection: Users can read profiles; only document owners can update profile info
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || (
        isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['householdId', 'fcmToken'])
      );
    }
    
    // 2. Households collection: Restricted to members, admin, pending joiners, or invite code queries
    match /households/{householdId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.adminId == request.auth.uid ||
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid in resource.data.pendingUserIds ||
        request.resource.data.pendingUserIds.hasAny([request.auth.uid])
      );
    }
    
    // 3. Shopping Lists collection: Users can ONLY access lists belonging to THEIR household
    match /shopping_lists/{listId} {
      allow read: if isAuthenticated() && (
        resource.data.householdId == getUserData().householdId
      );
      allow create: if isAuthenticated() && (
        request.resource.data.householdId == getUserData().householdId
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.householdId == getUserData().householdId
      );
    }

    // 4. Notifications collection: Real-time notification dispatching restricted to authenticated users
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.senderUid == request.auth.uid;
    }
  }
}
